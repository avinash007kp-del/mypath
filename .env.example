# ==============================================================================
# MyPath – Environment Variables
# ==============================================================================

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/mypath?retryWrites=true&w=majority
#
# Example for Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/mypath

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI API Configuration (Phase 5: AI-Powered Learning Assistant)
# Provide your OpenAI API key for live GPT-4o-mini generation.
# If omitted or invalid, MyPath operates in Smart Heuristic/Simulation mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2500
AI_TEMPERATURE=0.7


